#!/bin/sh
# IBM/Lenovo fan level via /proc/acpi/ibm/fan

. "$HOME/.local/bin/dwmblocks-lib" 2>/dev/null || . /usr/local/bin/dwmblocks-lib 2>/dev/null || . "${0%/*}/dwmblocks-lib"

[ -n "$BUTTON" ] && exit 0

speed=$(awk '/^level/ {print $2; exit}' /proc/acpi/ibm/fan 2>/dev/null) || exit

case "$speed" in
	auto) printf '%s%sauto' "$NF_FAN" "$ICON_GAP" ;;
	disengaged) printf '%s%smax' "$NF_FAN" "$ICON_GAP" ;;
	*) printf '%s%s%s' "$NF_FAN" "$ICON_GAP" "$speed" ;;
esac
