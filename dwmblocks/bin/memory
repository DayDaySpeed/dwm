#!/bin/sh

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

case $BUTTON in
	1) notify-send "$NF_MEM 内存" "$(ps axch -o cmd:15,%mem --sort=-%mem | head)" ;;
	2) setsid -f "$TERMINAL" -e htop ;;
	3) notify-send "$NF_MEM 内存" "\- 显示已用/总量
- 左键: 内存占用进程
- 中键: htop" ;;
	6) "$TERMINAL" -e "${EDITOR:-vi}" "$0" ;;
esac

[ -n "$BUTTON" ] && exit 0

printf '%s%s' "$NF_MEM" "$ICON_GAP"
free --mega | sed -n '2{p;q}' | awk '{printf "%.2fGB / %.2fGB", $3/1000, $2/1000}'
