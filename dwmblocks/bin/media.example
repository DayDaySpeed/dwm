#!/bin/sh
# Rename to `media` and put in $PATH to enable the media block in config.h.
# Requires: playerctl

. "$HOME/.local/bin/dwmblocks-lib" 2>/dev/null || . /usr/local/bin/dwmblocks-lib 2>/dev/null || . "${0%/*}/dwmblocks-lib"

case $BUTTON in
	1) playerctl play-pause ;;
	3) playerctl next ;;
	4) playerctl previous ;;
esac

[ -n "$BUTTON" ] && exit 0

meta=$(playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null | head -c 40)
[ -n "$meta" ] && printf '%s %s' "$NF_MEDIA" "$meta"
