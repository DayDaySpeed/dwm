#!/bin/sh
# Speaker: 0% = quietest, 100% = loudest (mute is separate, middle-click).

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

WVP="$DWMBLOCKS_BIN/wpctl-vol"
[ -x "$WVP" ] || WVP=wpctl-vol
dev=@DEFAULT_SINK@

case "$1" in
up)   exec "$WVP" step "$dev" 5 ;;
down) exec "$WVP" step "$dev" -5 ;;
esac

if [ -n "$SCROLL_STEPS" ]; then
	"$WVP" scroll "$dev" "$SCROLL_STEPS"
elif [ -n "$BUTTON" ]; then
	case $BUTTON in
	1)
		if command -v pavucontrol >/dev/null 2>&1; then
			exec setsid -f pavucontrol
		elif command -v helvum >/dev/null 2>&1; then
			exec setsid -f helvum
		fi
		notify-send "音量" "请安装 pavucontrol 或 helvum"
		;;
	2) wpctl set-mute "$dev" toggle ;;
	3) notify-send "$NF_VOL_HIGH 扬声器" "0% 最安静 · 100% 最响\n滚轮 ±5% · 中键静音（与 0% 无关）" ;;
		4) "$WVP" scroll "$dev" 1 ;;
		5) "$WVP" scroll "$dev" -1 ;;
	esac
	exit 0
fi

vol=$("$WVP" pct "$dev") || { printf '%s%s?%%' "$NF_VOL_MUTE" "$ICON_GAP"; exit 0; }
muted=$("$WVP" mute "$dev") || muted=0

if [ "$muted" = 1 ]; then
	printf '%s%s%s%%' "$NF_VOL_MUTE" "$ICON_GAP" "$vol"
elif [ "$vol" -eq 0 ]; then
	printf '%s%s0%%' "$NF_VOL_MUTE" "$ICON_GAP"
elif [ "$vol" -eq 100 ]; then
	printf '%s%s100%%' "$NF_VOL_HIGH" "$ICON_GAP"
elif [ "$vol" -gt 70 ]; then
	printf '%s%s%s%%' "$NF_VOL_HIGH" "$ICON_GAP" "$vol"
elif [ "$vol" -lt 30 ]; then
	printf '%s%s%s%%' "$NF_VOL_LOW" "$ICON_GAP" "$vol"
else
	printf '%s%s%s%%' "$NF_VOL_MED" "$ICON_GAP" "$vol"
fi
