#!/bin/sh
# Microphone: 0% = lowest gain, 100% = highest (mute is separate).

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

WVP="$DWMBLOCKS_BIN/wpctl-vol"
[ -x "$WVP" ] || WVP=wpctl-vol
dev=@DEFAULT_SOURCE@
export WPCTL_VOL_MAX=153

case "$1" in
up)   exec "$WVP" step "$dev" 5 ;;
down) exec "$WVP" step "$dev" -5 ;;
esac

if [ -n "$SCROLL_STEPS" ]; then
	"$WVP" scroll "$dev" "$SCROLL_STEPS"
elif [ -n "$BUTTON" ]; then
	case $BUTTON in
	1)
		if command -v pavucontrol >/dev/null 2>&1; then
			exec setsid -f pavucontrol --tab=1
		elif command -v helvum >/dev/null 2>&1; then
			exec setsid -f helvum
		fi
		notify-send "$NF_MIC 麦克风" "请安装 pavucontrol 以图形化配置输入设备"
		;;
	2) wpctl set-mute "$dev" toggle ;;
	3) notify-send "$NF_MIC 麦克风" "左键: pavucontrol 录音\n中键: 静音\n滚轮: 增益 ±5%\n状态栏 100% = pavucontrol 153%" ;;
		4) "$WVP" scroll "$dev" 1 ;;
		5) "$WVP" scroll "$dev" -1 ;;
	esac
	exit 0
fi

vol=$("$WVP" pct "$dev") || { printf '%s%s?%%' "$NF_MIC" "$ICON_GAP"; exit 0; }
muted=$("$WVP" mute "$dev") || muted=0

if [ "$muted" = 1 ]; then
	printf '%s%s%s%%' "$NF_MIC_MUTE" "$ICON_GAP" "$vol"
elif [ "$vol" -eq 0 ]; then
	printf '%s%s0%%' "$NF_MIC" "$ICON_GAP"
elif [ "$vol" -eq 100 ]; then
	printf '%s%s100%%' "$NF_MIC" "$ICON_GAP"
else
	printf '%s%s%s%%' "$NF_MIC" "$ICON_GAP" "$vol"
fi
