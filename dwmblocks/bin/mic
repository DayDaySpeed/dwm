#!/bin/sh
# Microphone: 0% = lowest gain, 100% = highest (mute is separate).

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

WVP="$DWMBLOCKS_BIN/wpctl-vol"
[ -x "$WVP" ] || WVP=wpctl-vol
dev=@DEFAULT_SOURCE@

case "$1" in
up)   exec "$WVP" step "$dev" 5 ;;
down) exec "$WVP" step "$dev" -5 ;;
esac

if [ -n "$SCROLL_STEPS" ]; then
	"$WVP" scroll "$dev" "$SCROLL_STEPS"
elif [ -n "$BUTTON" ]; then
	case $BUTTON in
	1|2) wpctl set-mute "$dev" toggle ;;
	3) notify-send "$NF_MIC 麦克风" "0% 最低 · 100% 最高\n滚轮 ±5% · 左/中键静音" ;;
		4) "$WVP" scroll "$dev" 1 ;;
		5) "$WVP" scroll "$dev" -1 ;;
	esac
	exit 0
fi

vol=$("$WVP" pct "$dev") || { printf '%s?%%' "$NF_MIC"; exit 0; }
muted=$("$WVP" mute "$dev") || muted=0

if [ "$muted" = 1 ]; then
	printf ' %s%s%% ' "$NF_MIC_MUTE" "$vol"
elif [ "$vol" -eq 0 ]; then
	printf ' %s0%% ' "$NF_MIC"
elif [ "$vol" -eq 100 ]; then
	printf ' %s100%% ' "$NF_MIC"
else
	printf ' %s%s%% ' "$NF_MIC" "$vol"
fi
