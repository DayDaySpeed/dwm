#!/bin/sh

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

case $BUTTON in
	1)
		notify-send "Today's date" "$(date '+%A, %d %B %Y')"
		notify-send "Current hour" "$(date '+%R:%S')"
		notify-send "Yesterday's date" "$(date '+%A %d %B %y' -d 'yesterday')"
		notify-send "Tomorrow's date" "$(date '+%A %d %B %y' -d 'tomorrow')"
		;;
	2) command -v calcurse >/dev/null && setsid -f "${TERMINAL:-st}" -e calcurse ;;
	3) notify-send "$NF_CLOCK 日期时间" "\- 左键: 显示日期通知
- 中键: 打开 calcurse（若已安装）" ;;
	6) "${TERMINAL:-st}" -e "${EDITOR:-vi}" "$0" ;;
esac

[ -n "$BUTTON" ] && exit 0

printf '%s%s%s' "$NF_CLOCK" "$ICON_GAP" "$(date '+%-l:%M %p')"
