#!/bin/sh

# WiFi / ethernet / VPN status with Nerd Font icons.

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

case $BUTTON in
	1) setsid -f "${TERMINAL:-st}" -e nmtui ;;
	3) notify-send "$NF_ETH 网络" "\- 左键: nmtui
$NF_WIFI_OFF: 无 WiFi
$NF_WIFI: WiFi 已连接
$NF_ETH_OFF: 无有线
$NF_ETH: 有线已连接
$NF_VPN: VPN 已启用" ;;
	6) "${TERMINAL:-st}" -e "${EDITOR:-vi}" "$0" ;;
esac

[ -n "$BUTTON" ] && exit 0

case "$(cat /sys/class/net/w*/operstate 2>/dev/null)" in
	down) wifiicon="$NF_WIFI_OFF " ;;
	up) wifiicon="$NF_WIFI " wifiname=$(iw dev wlp3s0 info 2>/dev/null | grep ssid | awk '{print $2}');;
esac

printf "%s%s%s%s" "$wifiicon" "$wifiname " \
	"$(sed "s/down/$NF_ETH_OFF/;s/up/$NF_ETH/" /sys/class/net/e*/operstate 2>/dev/null)" \
	"$(sed "s/.*/$NF_VPN/" /sys/class/net/tun*/operstate 2>/dev/null)"
