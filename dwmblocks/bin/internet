#!/bin/sh

# WiFi / ethernet / VPN status with Nerd Font icons.

for _lib in "${0%/*}/dwmblocks-lib" "$HOME/.local/bin/dwmblocks-lib" /usr/local/bin/dwmblocks-lib; do
	[ -r "$_lib" ] && . "$_lib" && break
done

case $BUTTON in
	1) setsid -f "${TERMINAL:-st}" -e nmtui ;;
	3) notify-send "$NF_ETH 网络" "\- 左键: nmtui
$NF_WIFI_OFF: 无 WiFi
$NF_WIFI: WiFi 已连接
$NF_ETH_OFF: 无有线
$NF_ETH: 有线已连接
$NF_VPN: VPN 已启用" ;;
	6) "${TERMINAL:-st}" -e "${EDITOR:-vi}" "$0" ;;
esac

[ -n "$BUTTON" ] && exit 0

wifiicon="$NF_WIFI_OFF"
wifiname=""

if command -v iw >/dev/null 2>&1; then
	for iface in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		[ "$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)" = up ] || continue
		ssid=$(iw dev "$iface" info 2>/dev/null | awk '/ssid/ { print $2; exit }')
		wifiicon="$NF_WIFI"
		wifiname="$ssid"
		break
	done
elif [ "$(cat /sys/class/net/w*/operstate 2>/dev/null)" = up ]; then
	wifiicon="$NF_WIFI"
	wifiname=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1 == "yes" { print $2; exit }')
fi

eth=$(sed "s/down/$NF_ETH_OFF/;s/up/$NF_ETH/" /sys/class/net/e*/operstate 2>/dev/null | tr '\n' ' ')
vpn=$(sed "s/.*/$NF_VPN/" /sys/class/net/tun*/operstate 2>/dev/null | tr '\n' ' ')

printf '%s' "$wifiicon"
[ -n "$wifiname" ] && printf '%s%s' "$ICON_GAP" "$wifiname"
for seg in $eth $vpn; do
	[ -n "$seg" ] && printf '%s%s' "$SEG_GAP" "$seg"
done
