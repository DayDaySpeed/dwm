#!/bin/sh
# PipeWire volume on a linear 0–100 UI scale.
# UI 0 = min, UI 100 = WPCTL_VOL_MAX% in wpctl/pavucontrol (default 100, mic uses 153).
#
#   wpctl-vol pct    <ID>           — print UI 0–100
#   wpctl-vol set    <ID> <0-100>   — absolute UI level
#   wpctl-vol step   <ID> <±N>      — step by N UI points
#   wpctl-vol scroll <ID> <±steps>  — steps × 5 UI points
#   wpctl-vol mute   <ID>           — print 1 if muted else 0
#   wpctl-vol cap    <ID>           — clamp to UI scale

set -e

cmd=$1
dev=$2
arg=$3

[ -n "$cmd" ] && [ -n "$dev" ] || exit 1

# wpctl/pavucontrol percent cap (100 = 1.0, 153 = 1.53)
vol_max_pct() {
	_max=${WPCTL_VOL_MAX:-100}
	case "$_max" in
	''|*[!0-9]*) _max=100 ;;
	esac
	[ "$_max" -lt 1 ] && _max=100
	printf '%s\n' "$_max"
}

vol_limit() {
	# shellcheck disable=SC2046
	awk -v m="$(vol_max_pct)" 'BEGIN { printf "%.2f\n", m / 100 }'
}

# UI 0–100 from wpctl Volume: line (0.0–limit)
vol_pct_read() {
	_max=$(vol_max_pct)
	wpctl get-volume "$dev" 2>/dev/null | awk -v max="$_max" '/Volume:/ {
		ui = int($2 * 100 / (max / 100) + 0.5)
		if (ui > 100) ui = 100
		if (ui < 0) ui = 0
		print ui
		found = 1
		exit
	}
	END { exit !found }'
}

vol_pct_set() {
	pct=$1
	_max=$(vol_max_pct)
	case "$pct" in
	''|*[!0-9]*) return 1 ;;
	esac
	[ "$pct" -gt 100 ] && pct=100
	[ "$pct" -lt 0 ] && pct=0
	wpctl_pct=$(( pct * _max / 100 ))
	_limit=$(vol_limit)
	wpctl set-volume -l "$_limit" "$dev" "${wpctl_pct}%" >/dev/null 2>&1
}

vol_unmute() {
	wpctl set-mute "$dev" 0 >/dev/null 2>&1 || true
}

vol_wpctl_delta() {
	ui_delta=$1
	_max=$(vol_max_pct)
	[ "$ui_delta" -eq 0 ] && return 0
	wpctl_delta=$(( ui_delta * _max / 100 ))
	[ "$wpctl_delta" -eq 0 ] && wpctl_delta=1
	vol_unmute
	_limit=$(vol_limit)
	if [ "$wpctl_delta" -lt 0 ]; then
		wpctl_delta=$(( -wpctl_delta ))
		wpctl set-volume -l "$_limit" "$dev" "${wpctl_delta}%-" >/dev/null 2>&1
	else
		wpctl set-volume -l "$_limit" "$dev" "${wpctl_delta}%+" >/dev/null 2>&1
	fi
}

case "$cmd" in
set)
	[ -n "$arg" ] || exit 1
	vol_unmute
	vol_pct_set "$arg"
	;;
step)
	[ -n "$arg" ] || exit 1
	vol_wpctl_delta "$arg"
	;;
scroll)
	steps=$arg
	[ -n "$steps" ] || exit 1
	vol_wpctl_delta $(( steps * 5 ))
	;;
pct)
	vol_pct_read
	;;
mute)
	if wpctl get-volume "$dev" 2>/dev/null | grep -q '\[MUTED\]'; then
		echo 1
	else
		echo 0
	fi
	;;
cap)
	pct=$(vol_pct_read) || exit 0
	vol_pct_set "$pct"
	;;
*)
	exit 1
	;;
esac
